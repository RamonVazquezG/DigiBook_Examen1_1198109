<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboardScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".dashboardFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Perfil -->
        <ImageView
            android:id="@+id/imageUserProfile"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_profile_image_border"
            android:clickable="true"
            android:contentDescription="@string/user_profile_picture"
            android:focusable="true"
            android:padding="4dp"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@android:drawable/ic_menu_camera" />

        <TextView
            android:id="@+id/textUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageUserProfile"
            tools:text="Usuario" />

        <!-- Sección de API -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInspiration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#F3E5F5"
            app:layout_constraintTop_toBottomOf="@id/textUsername">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ Inspiración Diaria"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#4A148C"/>

                <TextView
                    android:id="@+id/textApiStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Toca para ver una frase motivacional"
                    android:textSize="14sp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonOpenQuote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Ver Cita"
                    android:backgroundTint="#7B1FA2"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Estadísticas (Opcional, manteniendo estructura) -->
        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/gridLayoutStats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:columnCount="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardInspiration"
            app:useDefaultMargins="true">
            <!-- Contenido placeholder -->
        </androidx.gridlayout.widget.GridLayout>

        <!-- Botones Principales (MORADOS) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonLastNotebook"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:text="@string/last_notebook"
            android:textColor="#6200EE"
            app:strokeColor="#6200EE"
            app:iconTint="#6200EE"
            app:icon="@android:drawable/ic_menu_recent_history"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/gridLayoutStats" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonNewNotebook"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:text="@string/new_notebook"
            android:backgroundTint="#6200EE"
            android:textColor="@android:color/white"
            app:icon="@android:drawable/ic_menu_add"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonLastNotebook" />

        <!-- Alarma -->
        <TextView
            android:id="@+id/textAlarmTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/alarm_settings"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/buttonNewNotebook" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSetAlarm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_alarm"
            android:backgroundTint="#6200EE"
            app:icon="@android:drawable/ic_lock_idle_alarm"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textAlarmTitle" />

        <TextView
            android:id="@+id/textAlarmStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Sin alarma activa"
            app:layout_constraintTop_toBottomOf="@id/buttonSetAlarm" />

        <!-- SECCIÓN LISTA DE NOTAS -->
        <TextView
            android:id="@+id/textNotesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mis Notas Guardadas"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#673AB7"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintTop_toBottomOf="@id/textAlarmStatus"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerNotes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/textNotesTitle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_note"
            tools:itemCount="3"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>